<div class="kira-right-column">
	<div class="kira-right-widgets">
		<!-- 即时搜索 -->
		<div class="kira-right-search">
			<div class="kira-right-search-box">
				<input type="text" id="kira-search-input-right" placeholder="搜索文章..." autocomplete="off" />
				<i class="kirafont icon-search"></i>
			</div>
			<div class="kira-right-search-results" id="kira-search-results-right"></div>
		</div>

		</div>

	<a onclick="document.querySelector('#kira-top-header').scrollIntoView({behavior: 'smooth'});" class="kira-backtotop" aria-label="回到顶部" title="回到顶部">
		<button class="mdui-fab mdui-ripple">
			<i class="kirafont icon-caret-up"></i>
		</button>
	</a>
</div>

<script>
(function() {
	var input = document.getElementById('kira-search-input-right');
	var results = document.getElementById('kira-search-results-right');
	var posts = [];
	var timer;

	fetch('<%- config.root %>search.json')
		.then(function(r) { return r.json(); })
		.then(function(d) { posts = d; });

	input.addEventListener('input', function() {
		clearTimeout(timer);
		var q = this.value.trim();
		if (!q) { results.innerHTML = ''; results.style.display = 'none'; return; }
		if (!posts.length) return;
		timer = setTimeout(function() {
			var ql = q.toLowerCase();
			var list = posts.filter(function(p) {
				return p.title.toLowerCase().indexOf(ql) > -1;
			}).slice(0, 8);
			if (!list.length) {
				results.innerHTML = '<div class="kira-search-noresult">无结果</div>';
				results.style.display = 'block';
				return;
			}
			var html = '';
			list.forEach(function(p) {
				html += '<a href="' + p.url + '">' + p.title + '</a>';
			});
			results.innerHTML = html;
			results.style.display = 'block';
		}, 200);
	});

	document.addEventListener('click', function(e) {
		if (!e.target.closest('.kira-right-search')) {
			results.style.display = 'none';
		}
	});

	document.addEventListener('keydown', function(e) {
		if (e.key === 'Escape' && document.activeElement === input) {
			input.value = '';
			results.style.display = 'none';
			input.blur();
		}
	});
})();
</script>
