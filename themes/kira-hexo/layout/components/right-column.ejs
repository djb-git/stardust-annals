<div class="kira-right-column">
	<div class="kira-right-widgets">
		<!-- 即时搜索 -->
		<div class="kira-right-search">
			<div class="kira-right-search-box">
				<i class="kirafont icon-search"></i>
				<input type="text" id="kira-search-input-right" placeholder="搜索文章…" autocomplete="off" />
				<button type="button" class="kira-search-clear" id="kira-search-clear-right" aria-label="清空搜索"><i class="kirafont icon-close"></i></button>
			</div>
			<div class="kira-right-search-results" id="kira-search-results-right"></div>
		</div>

		<% if (page.toc && page.content) { %>
			<!-- 文章步骤导航 -->
			<% var kiraTocHtml = toc(page.content, { min_depth: 2, max_depth: 3, list_number: false, class: 'kira-toc' }); %>
			<% if (kiraTocHtml) { %>
			<nav class="kira-right-toc" id="kira-right-toc">
				<div class="kira-right-widget-title">步骤导航</div>
				<%- kiraTocHtml %>
			</nav>
			<% } %>
		<% } %>

		</div>

	<a onclick="document.querySelector('#kira-top-header').scrollIntoView({behavior: 'smooth'});" class="kira-backtotop" aria-label="回到顶部" title="回到顶部">
		<button class="mdui-fab mdui-ripple">
			<i class="kirafont icon-caret-up"></i>
		</button>
	</a>
</div>

<script>
kiraSearch({
	input: 'kira-search-input-right',
	results: 'kira-search-results-right',
	clear: 'kira-search-clear-right',
	url: '<%- config.root %>search.json',
	mode: 'dropdown',
	max: 8
});
</script>

<% if (page.toc) { %>
<script>
/* 步骤导航：滚动时高亮当前章节 */
(function() {
	var nav = document.getElementById('kira-right-toc');
	if (!nav) return;

	var links = Array.prototype.slice.call(nav.querySelectorAll('a.kira-toc-link'));
	if (!links.length) return;

	// 解析每个链接对应的标题元素
	var targets = links.map(function(a) {
		var href = a.getAttribute('href') || '';
		if (href.charAt(0) !== '#') return null;
		var id = href.slice(1);
		try { id = decodeURIComponent(id); } catch (e) {}
		return document.getElementById(id);
	});

	var scroller = nav.closest ? nav.closest('.kira-right-widgets') : null;
	var current = -2;

	function setActive(index) {
		if (index === current) return;
		if (current >= 0 && links[current]) links[current].classList.remove('active');
		current = index;
		if (index < 0 || !links[index]) return;
		links[index].classList.add('active');
		// 让高亮项在导航内部可见（只动导航自身的滚动，不影响页面）
		if (!scroller) return;
		var boxRect = scroller.getBoundingClientRect();
		var elRect = links[index].getBoundingClientRect();
		if (elRect.top < boxRect.top) {
			scroller.scrollTop -= boxRect.top - elRect.top;
		} else if (elRect.bottom > boxRect.bottom) {
			scroller.scrollTop += elRect.bottom - boxRect.bottom;
		}
	}

	var ticking = false;
	function update() {
		ticking = false;
		var best = -1;
		for (var i = 0; i < targets.length; i++) {
			if (!targets[i]) continue;
			if (targets[i].getBoundingClientRect().top <= 120) best = i;
			else break;
		}
		// 还没滚到第一个标题时，默认高亮第一项
		setActive(best < 0 ? 0 : best);
	}

	function onScroll() {
		if (ticking) return;
		ticking = true;
		window.requestAnimationFrame(update);
	}

	/* ---------- 点击跳转 ---------- */
	// 本主题布局特殊：body 是 position:absolute + height:100vh，文章列又是
	// overflow:auto，原生锚点滚动会被中间的滚动容器吞掉导致点了没反应。
	// 所以这里自己算出目标位置，显式滚动每一层可滚动祖先和文档。
	function docScrollY() {
		return window.pageYOffset ||
			(document.documentElement && document.documentElement.scrollTop) ||
			(document.body && document.body.scrollTop) || 0;
	}

	var pendingEl = null; // 记住最后一次点击的目标，供动画结束后的校验使用

	function scrollToTarget(el) {
		var offset = 18; // 与 CSS 的 scroll-margin-top 保持一致

		// 尊重系统的「减弱动态效果」偏好
		var behavior = 'smooth';
		try {
			if (window.matchMedia &&
				window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				behavior = 'auto';
			}
		} catch (err) {}

		// 收集可滚动的祖先容器。容器滚动自身内容不会改变它自己的 rect，
		// 所以下面算出的目标值在动画过程中依然成立，可以先算再滚。
		var chain = [];
		var node = el.parentElement;
		while (node && node !== document.documentElement) {
			var overflowY = '';
			try { overflowY = window.getComputedStyle(node).overflowY; } catch (err) {}
			if ((overflowY === 'auto' || overflowY === 'scroll') &&
				node.scrollHeight > node.clientHeight + 1) {
				chain.push(node);
			}
			node = node.parentElement;
		}

		var elTop = el.getBoundingClientRect().top;
		var docTop;

		if (chain.length) {
			// 元素所在滚动容器：把标题对齐到容器顶部往下 offset 处
			var box = chain[0];
			var boxTop = box.getBoundingClientRect().top;
			var boxTarget = box.scrollTop + elTop - boxTop - offset;
			// 文档：把容器顶端对齐到视口顶端，此时标题正好落在 offset 处
			docTop = docScrollY() + boxTop;
			try {
				box.scrollTo({ top: boxTarget, behavior: behavior });
			} catch (err) {
				box.scrollTop = boxTarget;
			}
		} else {
			docTop = docScrollY() + elTop - offset;
		}

		try {
			window.scrollTo({ top: docTop, behavior: behavior });
		} catch (err) {
			window.scrollTo(0, docTop);
		}

		// 动画结束后校验一次；万一没到位，用原生的滚动到可视区域即时兜底
		pendingEl = el;
		setTimeout(function() {
			if (pendingEl !== el) return;
			if (Math.abs(el.getBoundingClientRect().top - offset) > 200) {
				try {
					el.scrollIntoView({ block: 'start' });
				} catch (err) {
					try { el.scrollIntoView(); } catch (err2) {}
				}
			}
		}, 1200);
	}

	nav.addEventListener('click', function(e) {
		var link = (e.target && e.target.closest) ? e.target.closest('a.kira-toc-link') : null;
		if (!link) return;

		var href = link.getAttribute('href') || '';
		if (href.charAt(0) !== '#') return;

		var id = href.slice(1);
		try { id = decodeURIComponent(id); } catch (err) {}
		var el = document.getElementById(id);
		if (!el) return;

		e.preventDefault();
		scrollToTarget(el);

		// 同步地址栏，方便复制分享（replaceState 不会触发跳转）
		if (window.history && window.history.replaceState) {
			window.history.replaceState(null, '', href);
		}
		// 立刻给出反馈，不等滚动事件
		var idx = links.indexOf(link);
		if (idx > -1) setActive(idx);
	});

	// 用捕获阶段监听，任何容器（不只是 window）滚动都能触发高亮更新
	document.addEventListener('scroll', onScroll, { passive: true, capture: true });
	window.addEventListener('resize', onScroll);
	update();
})();
</script>
<% } %>
