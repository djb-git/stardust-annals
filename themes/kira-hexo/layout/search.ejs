<div class="kira-search-page">
	<div class="kira-search-head">
		<h2 class="kira-search-heading">搜索文章</h2>
		<p class="kira-search-desc">支持匹配文章标题与正文，试试输入「Clash」「订阅」或「博客」。</p>
		<div class="kira-search-input-wrap">
			<i class="kirafont icon-search"></i>
			<input type="text" id="kira-search-input" placeholder="输入关键词…" autocomplete="off" autofocus />
			<button type="button" class="kira-search-clear" id="kira-search-clear" aria-label="清空搜索"><i class="kirafont icon-close"></i></button>
		</div>
		<div class="kira-search-count" id="kira-search-count"></div>
	</div>
	<div id="kira-search-results"></div>
</div>
<script>
kiraSearch({
	input: 'kira-search-input',
	results: 'kira-search-results',
	count: 'kira-search-count',
	clear: 'kira-search-clear',
	url: '<%- config.root %>search.json',
	mode: 'page'
});
</script>
