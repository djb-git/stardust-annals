@import 'constants.styl';

// ===== 文章装饰：提示卡片 / 图注 / 折叠问答（kira-decorate） =====

article {
	// 提示卡片：默认蓝色强调，.tip 绿色，.warn 红色
	.kira-note {
		position: relative;
		box-sizing: border-box;
		margin: $gutter 0;
		padding: 0.85em 1.15em;
		border: 1px solid rgba($color1, 0.35);
		border-left-width: 4px;
		border-radius: 10px;
		background-color: rgba($color1, 0.07);
		color: #555;
		font-size: 0.95em;
		line-height: 27px;

		strong {
			color: $color1;
		}

		&:first-child {
			margin-top: 0;
		}
	}

	.kira-note.tip {
		border-color: rgba($color4, 0.4);
		background-color: rgba($color4, 0.09);

		strong {
			color: #1f9d55;
		}
	}

	.kira-note.warn {
		border-color: rgba($color2, 0.35);
		background-color: rgba($color2, 0.07);

		strong {
			color: $color2;
		}
	}

	// 图片说明文字
	.kira-caption {
		margin: -8px 0 $gutter;
		text-align: center;
		font-size: 0.85em;
		line-height: 22px;
		color: #999;
	}

	// 标题锚点（Hexo 自动生成的空 <a class="headerlink">）
	// 主题的 article a::before 会给它塞一个链接图标，这里去掉
	h1 > a.headerlink,
	h2 > a.headerlink,
	h3 > a.headerlink,
	h4 > a.headerlink,
	h5 > a.headerlink,
	h6 > a.headerlink {
		display: none;
	}

	// 从步骤导航跳转时，给目标标题留出上边距，避免紧贴视口顶部
	h2,
	h3,
	h4 {
		scroll-margin-top: 18px;
	}

	// 折叠问答（原生 details/summary）
	details {
		margin: $gutter 0;
		padding: 0.35em 1.1em;
		border: 1px solid #eee;
		border-radius: 10px;
		background-color: #fafafa;

		summary {
			padding: 0.5em 0;
			color: #555;
			font-weight: 600;
		}

		&[open] summary {
			margin-bottom: 0.6em;
			border-bottom: 1px dashed #eee;
		}
	}

	// 任务清单：隐藏主题的圆点与竖线，只留勾选框
	// marked 不一定会输出 contains-task-list 类，所以额外用 :has() 兜底
	ul.contains-task-list li,
	ul:has(> li > input[type='checkbox']) > li {
		padding-left: 0;

		&::before,
		&::after {
			display: none;
		}
	}
}

[data-theme='dark'] {
	article {
		.kira-note {
			color: #bbb;
			border-color: #444;
			border-left-color: $color1;
			background-color: rgba($color1, 0.12);
		}

		.kira-note.tip {
			border-left-color: $color4;
			background-color: rgba($color4, 0.12);

			strong {
				color: $color4;
			}
		}

		.kira-note.warn {
			border-left-color: $color2;
			background-color: rgba($color2, 0.12);

			strong {
				color: $color2;
			}
		}

		.kira-caption {
			color: #777;
		}

		details {
			border-color: #444;
			background-color: #262626;

			summary {
				color: #bbb;
			}

			&[open] summary {
				border-bottom-color: #444;
			}
		}
	}
}
