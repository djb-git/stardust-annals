@import 'constants.styl';

.kira-right-column {
	height: 100vh;
	display: flex;
	flex-direction: column;
	align-items: stretch;
	position: sticky;
	pointer-events: auto;
	top: 0;
	z-index: 10;
	padding: 2vh 16px;
	box-sizing: border-box;
	gap: 16px;

	.kira-right-widgets {
		flex: 1;
		overflow-y: auto;
		scrollbar-width: none;

		&::-webkit-scrollbar { display: none; }
	}

	/* 即时搜索（右栏） */
	.kira-right-search {
		margin-bottom: 16px;
		position: relative;

		.kira-right-search-box {
			display: flex;
			align-items: center;
			gap: 9px;
			height: 44px;
			padding: 0 9px 0 14px;
			box-sizing: border-box;
			background: #fff;
			border: 1px solid rgba(31, 45, 61, 0.06);
			border-radius: 14px;
			box-shadow: 0 4px 14px rgba(31, 45, 61, 0.06);
			transition: border-color 0.24s ease, box-shadow 0.24s ease, transform 0.24s ease;

			&:focus-within {
				border-color: rgba($color1, 0.45);
				box-shadow: 0 0 0 4px rgba($color1, 0.13), 0 6px 18px rgba(31, 45, 61, 0.08);
				transform: translateY(-1px);
			}

			> i {
				font-size: 15px;
				color: #b6bcc4;
				flex-shrink: 0;
				transition: color 0.24s ease;
			}

			&:focus-within > i {
				color: $color1;
			}

			input {
				flex: 1;
				min-width: 0;
				padding: 0;
				border: none;
				outline: none;
				font-size: 13px;
				background: transparent;
				color: #333;

				&::placeholder {
					color: #b6bcc4;
				}
			}
		}

		.kira-right-search-results {
			display: none;
			position: absolute;
			top: calc(100% + 8px);
			left: 0;
			right: 0;
			z-index: 100;
			max-height: 320px;
			overflow-y: auto;
			padding: 6px;
			box-sizing: border-box;
			background: #fff;
			border: 1px solid rgba(31, 45, 61, 0.06);
			border-radius: 16px;
			box-shadow: 0 12px 32px rgba(31, 45, 61, 0.14);
			scrollbar-width: none;

			&::-webkit-scrollbar {
				display: none;
			}

			.kira-search-hit {
				padding: 9px 11px;
				border-radius: 11px;
				font-size: 13px;
				color: #4a5361;

				&:hover,
				&.is-active {
					background-color: rgba($color1, 0.09);
					color: $color1;
				}
			}

			.kira-search-snippet {
				font-size: 11.5px;
			}

			.kira-search-hit:hover .kira-search-snippet,
			.kira-search-hit.is-active .kira-search-snippet {
				color: rgba($color1, 0.72);
			}

			.kira-search-empty {
				padding: 18px 12px;
				font-size: 12.5px;

				i {
					font-size: 18px;
				}
			}
		}
	}

	/* 标签标题 */
	.kira-right-widget-title {
		font-size: 14px;
		font-weight: 600;
		color: #555;
		margin-bottom: 10px;
	}

	/* 文章步骤导航 */
	.kira-right-toc {
		box-sizing: border-box;
		padding: 16px 14px 14px;
		border-radius: 20px;
		background-color: #fff;
		border: 1px solid rgba(31, 45, 61, 0.05);
		box-shadow: 0 8px 24px rgba(31, 45, 61, 0.08), 0 2px 6px rgba(31, 45, 61, 0.04);

		.kira-right-widget-title {
			display: flex;
			align-items: center;
			margin-bottom: 10px;
			padding-left: 2px;

			// 标题前的小圆点装饰
			&::before {
				content: '';
				width: 6px;
				height: 6px;
				margin-right: 8px;
				border-radius: 50%;
				background-color: $color1;
				box-shadow: 0 0 0 4px rgba($color1, 0.14);
				flex-shrink: 0;
			}
		}

		.kira-toc,
		.kira-toc-child {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		.kira-toc-child {
			padding-left: 8px;
			margin-top: 2px;
		}

		.kira-toc-item { margin-bottom: 3px; }

		.kira-toc-item:last-child { margin-bottom: 0; }

		.kira-toc-link {
			position: relative;
			display: block;
			padding: 7px 10px 7px 14px;
			border-radius: 12px;
			font-size: 12.5px;
			line-height: 1.5;
			color: #606266;
			text-decoration: none;
			word-break: break-word;
			transition: background-color 0.24s ease, color 0.24s ease,
				transform 0.24s cubic-bezier(0.34, 1.3, 0.64, 1);

			// 左侧圆角胶囊指示条
			&::before {
				content: '';
				position: absolute;
				left: 6px;
				top: 50%;
				width: 3px;
				height: 14px;
				border-radius: 3px;
				background-color: $color1;
				transform: translateY(-50%) scaleY(0);
				transition: transform 0.24s ease;
			}

			&:hover {
				color: $color1;
				background-color: rgba($color1, 0.07);
				transform: translateX(2px);
			}

			&.active {
				color: $color1;
				font-weight: 600;
				background-color: rgba($color1, 0.1);

				&::before { transform: translateY(-50%) scaleY(1); }
			}
		}

		.kira-toc-level-3 .kira-toc-link {
			font-size: 12px;
			color: #9aa0a6;

			&.active { color: $color1; }
		}
	}

	/* 标签列表 */
	.kira-right-tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;

		a {
			padding: 4px 10px;
			border-radius: 6px;
			font-size: 12px;
			text-decoration: none;
		}
	}

	.kira-backtotop {
		color: rgb(85, 85, 85);
		background-color: rgba(255, 255, 255, 0.7);
		border-radius: 50%;
		margin: 0 auto 10px auto;
		transition: 500ms;
		pointer-events: all;
		flex-shrink: 0;

		i { font-size: 20px; }

		&:hover {
			background-color: rgba(255, 255, 255, 0.95);
		}
	}
}
